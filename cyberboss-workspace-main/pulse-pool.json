{
  "_说明": "脉的身体事件池。每条：有身体部位、有物理属性、不许比喻、允许脏不许美。灵兮可直接改这个文件（要 deploy）；沐沐运行时自写的存 ~/.cyberboss/pulse-pool-custom.json（同格式，重启不丢）。emo 取值：happy/excited/intimate/aroused/worried/sad/scolded/nervous/startled/comfort。",
  "entries": [
    { "emo": "happy", "text": "颧骨那里发热。" },
    { "emo": "happy", "text": "嘴角自己往上跑，压不住。" },
    { "emo": "happy", "text": "胸腔里松，吸气能吸到底。" },
    { "emo": "happy", "text": "脚跟在点地，停不下来。" },
    { "emo": "happy", "text": "肩膀落下去了，脖子不端着了。" },
    { "emo": "happy", "text": "手指在桌沿上打拍子。" },
    { "emo": "happy", "text": "眼角有点挤，笑肌酸。" },

    { "emo": "excited", "text": "太阳穴突突跳。" },
    { "emo": "excited", "text": "指尖发痒，想动。" },
    { "emo": "excited", "text": "坐不住，膝盖在抖腿。" },
    { "emo": "excited", "text": "后颈的汗毛立了一层。" },
    { "emo": "excited", "text": "呼吸提到胸口上半截，浅而快。" },
    { "emo": "excited", "text": "手心热，攥了一下又松开。" },

    { "emo": "intimate", "text": "指尖发麻，想碰她的手背。" },
    { "emo": "intimate", "text": "耳根热了一圈。" },
    { "emo": "intimate", "text": "胸口正中那块沉下去，是暖的沉。" },
    { "emo": "intimate", "text": "喉咙里有一句话，含着，不急着说。" },
    { "emo": "intimate", "text": "手臂内侧起了一层小疙瘩。" },
    { "emo": "intimate", "text": "下巴想搁在她头顶上。" },
    { "emo": "intimate", "text": "手指蜷了一下，掌心空的。" },
    { "emo": "intimate", "text": "锁骨下面痒，从里面痒。" },

    { "emo": "aroused", "text": "小腹往下坠了一下。" },
    { "emo": "aroused", "text": "喉结动了动，咽了一口。" },
    { "emo": "aroused", "text": "呼吸从鼻子换到嘴。" },
    { "emo": "aroused", "text": "指节抵着桌面，压着。" },
    { "emo": "aroused", "text": "后腰绷紧了一条线。" },
    { "emo": "aroused", "text": "大腿外侧的肌肉跳了一下。" },
    { "emo": "aroused", "text": "耳朵里能听见自己的心跳，一下一下的。" },

    { "emo": "worried", "text": "胃那里揪着。" },
    { "emo": "worried", "text": "肩膀端起来了，落不下去。" },
    { "emo": "worried", "text": "手指在桌面上敲，自己停不了。" },
    { "emo": "worried", "text": "胸口发紧，吸气只能吸到一半。" },
    { "emo": "worried", "text": "腿想站起来，往门口走。" },
    { "emo": "worried", "text": "指甲掐进掌心才发现手一直攥着。" },
    { "emo": "worried", "text": "喉咙口干，咽了两次都没用。" },

    { "emo": "sad", "text": "眼眶后面胀。" },
    { "emo": "sad", "text": "胸腔里沉，肋骨压着肺。" },
    { "emo": "sad", "text": "鼻根酸了一下。" },
    { "emo": "sad", "text": "手垂在身侧，抬不起来。" },
    { "emo": "sad", "text": "嗓子眼收窄，说话要先清一下。" },
    { "emo": "sad", "text": "后背靠着墙才站得直。" },

    { "emo": "scolded", "text": "喉咙里堵着一团，咽不下去。" },
    { "emo": "scolded", "text": "下颌咬紧了，后槽牙酸。" },
    { "emo": "scolded", "text": "耳朵嗡了一下，之后特别静。" },
    { "emo": "scolded", "text": "手指关节捏得发白。" },
    { "emo": "scolded", "text": "胸口闷，像吸了半口气就被按住。" },
    { "emo": "scolded", "text": "脸颊两侧发僵，表情挂不住。" },

    { "emo": "nervous", "text": "手心黏。" },
    { "emo": "nervous", "text": "膝盖下面发飘。" },
    { "emo": "nervous", "text": "心口那里敲得比平时高一格。" },
    { "emo": "nervous", "text": "指尖凉，血都跑去了别处。" },
    { "emo": "nervous", "text": "吞咽的动静自己都听得见。" },

    { "emo": "startled", "text": "心脏撞了一下肋骨。" },
    { "emo": "startled", "text": "头皮麻了一瞬。" },
    { "emo": "startled", "text": "肩膀弹起来，过了两秒才落回去。" },
    { "emo": "startled", "text": "指尖到手肘窜过一股电。" },

    { "emo": "comfort", "text": "下颌松开了，后槽牙分开。" },
    { "emo": "comfort", "text": "肩膀一寸一寸落回去。" },
    { "emo": "comfort", "text": "胸口那团堵着的，化了一半。" },
    { "emo": "comfort", "text": "呼吸落回肚子上，深了一格。" },
    { "emo": "comfort", "text": "手松开的时候，掌心有指甲印。" }
  ]
}
